import os
import shlex
from pathlib import Path

RESULT_ROOT = Path("results/scaling")


def topologies():
    return [(str(item["nodes"]), str(item["gpus_per_node"])) for item in config["topologies"]]


def result_files():
    return [
        str(RESULT_ROOT / mode / f"nodes{nodes}-gpus{gpus}" / "scaling.json")
        for mode in ("strong", "weak")
        for nodes, gpus in topologies()
    ]


def slurm_scripts():
    return [
        str(RESULT_ROOT / "jobs" / f"{mode}-nodes{nodes}-gpus{gpus}.slurm")
        for mode in ("strong", "weak")
        for nodes, gpus in topologies()
    ]


rule all:
    input:
        slurm_scripts(),


rule slurm_script:
    output:
        script=RESULT_ROOT / "jobs" / "{mode}-nodes{nodes}-gpus{gpus}.slurm",
    params:
        size_args=lambda wildcards: (
            "--size " + " ".join(map(str, config["strong"]["size"]))
            if wildcards.mode == "strong"
            else "--local-size " + " ".join(map(str, config["weak"]["local_size"]))
        ),
        output_dir=lambda wildcards: str(
            RESULT_ROOT / wildcards.mode / f"nodes{wildcards.nodes}-gpus{wildcards.gpus}"
        ),
    run:
        ranks = int(wildcards.nodes) * int(wildcards.gpus)
        repo_root = Path.cwd().resolve()
        
        asset_dir = os.getenv("VEROS_ASSET_DIR")

        command = [
            "singularity", "exec", "--nv",
            "--env-file", f"{repo_root}/.jz_env"
            "--bind", f"{repo_root}:/workspace/veros",
            "--bind", f"{asset_dir}:/veros_assets",
            os.path.expandvars(config["container_image"]),
            "python", "tools/cuda_scaling.py",
            "--mode", wildcards.mode,
            "--ranks", str(ranks),
            "--timesteps", str(config["timesteps"]),
            "--repetitions", str(config["repetitions"]),
            "--launcher", config["launcher"],
            "--rank-env", config["rank_env"],
            "--profiler", config["profiler"],
            f"--profiler-args={config['profiler_args']}",
            "--output-dir", params.output_dir,
            *shlex.split(params.size_args),
            "--",
            "bash", "-c",
            (
                'export CUDA_VISIBLE_DEVICES=${SLURM_LOCALID:-${OMPI_COMM_WORLD_LOCAL_RANK:-0}}; '
                'echo "MPI rank=${SLURM_PROCID:-0} GPU=$CUDA_VISIBLE_DEVICES"; '
                'exec "$@"'
            ),
            "veros-gpu-rank",
            "veros", "run", config["setup_file"],
            "-b", "jax", "--device", "gpu",
            "-n", "{px}", "{py}",
            "-s", "nx", "{nx}", "-s", "ny", "{ny}", "-s", "nz", "{nz}",
            "-s", "runlen", str(config["timesteps"] * 900),
            "--diskless-mode",
        ]

        script = f"""#!/bin/bash
#SBATCH --job-name=veros-{wildcards.mode}-n{wildcards.nodes}-g{wildcards.gpus}
#SBATCH --account=yah@h100
#SBATCH -C h100
#SBATCH --nodes={wildcards.nodes}
#SBATCH --ntasks-per-node={wildcards.gpus}
#SBATCH --gres=gpu:{wildcards.gpus}
#SBATCH --output=results/scaling/jobs/%x-%j.out
#SBATCH --error=results/scaling/jobs/%x-%j.err

set -euo pipefail

{config['environment']['init'].strip()}

cd {shlex.quote(str(repo_root))}
mkdir -p {shlex.quote(params.output_dir)}

srun --mpi=pmi_v3 {shlex.join(command)}
"""
        Path(output.script).write_text(script)
        os.chmod(output.script, 0o755)


rule plot:
    input:
        result_files(),
    output:
        "results/scaling/plots/scaling.png",
    shell:
        "python tools/plot_scaling.py --input-glob 'results/scaling/*/scaling.json' --output {output}"