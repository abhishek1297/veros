Bootstrap: docker
From: nvcr.io/nvidia/jax:26.08-py3

%environment
    export DEBIAN_FRONTEND=noninteractive
    export CUDA_ROOT=/usr/local/cuda
    export CUDA_HOME=/usr/local/cuda
    export LC_ALL=C

%files
    requirements_container.txt /workspace/veros/requirements.txt
    . /workspace/veros/

%post
    export CUDA_ROOT=/usr/local/cuda
    export CUDA_HOME=/usr/local/cuda

    # Install required system libraries
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        libopenmpi-dev \
        openmpi-bin \
        libhdf5-openmpi-dev \
        git \
        && rm -rf /var/lib/apt-get/lists/*

    cd /workspace/veros

    # Upgrade build tools
    python3 -m pip install -U --no-cache-dir pip setuptools wheel cython

    # Compile mpi4py and mpi4jax against container CUDA/MPI
    python3 -m pip install -v --no-cache-dir --no-build-isolation --no-binary mpi4py mpi4py nanobind
    python3 -m pip install -v --no-cache-dir --no-build-isolation mpi4jax
    python3 -m pip install -v --no-cache-dir -r requirements.txt

    # Install Veros
    python3 -m pip install --no-cache-dir --no-build-isolation --no-deps -e .

%runscript
    exec python3 "$@"